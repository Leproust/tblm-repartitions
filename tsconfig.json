{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": false,
    "types": ["google-apps-script"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.gs"
  ],
  "exclude": ["dist", "node_modules"]
}
